<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ replacement for backup_rules.xml. Same two files for both
  cloud backup and device-to-device transfer: the Room database and
  the DataStore preferences file.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="budgetflow.db" />
        <include domain="database" path="budgetflow.db-shm" />
        <include domain="database" path="budgetflow.db-wal" />
        <include domain="file" path="datastore/budgetflow_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="budgetflow.db" />
        <include domain="database" path="budgetflow.db-shm" />
        <include domain="database" path="budgetflow.db-wal" />
        <include domain="file" path="datastore/budgetflow_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
